config SHIELD_DACTYL_MANUFORM_6X6_LEFT
    def_bool $(shields_list_contains,dactyl_manuform_6x6_left)

config SHIELD_DACTYL_MANUFORM_6X6_LEFT_PERIPHERAL
    def_bool $(shields_list_contains,dactyl_manuform_6x6_left_peripheral)

config SHIELD_DACTYL_MANUFORM_6X6_RIGHT
    def_bool $(shields_list_contains,dactyl_manuform_6x6_right)

config SHIELD_DACTYL_MANUFORM_6X6_DONGLE
    def_bool $(shields_list_contains,dactyl_manuform_6x6_dongle)

if SHIELD_DACTYL_MANUFORM_6X6_DONGLE

config DACTYL_MANUFORM_6X6_DISPLAY_FIXED_BRIGHTNESS
    int "Dactyl Manuform dongle display brightness"
    range 0 100
    default 80

endif
